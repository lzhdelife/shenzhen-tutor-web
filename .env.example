# TutorPlatform reads process environment variables directly. This file is a
# template only; see docs/DEVELOPMENT.md for Windows and deployment examples.
PORT=8787
TUTOR_DATA_DIR=

# Amap Web Service API key for POI matching, geocoding and route planning.
AMAP_WEB_SERVICE_KEY=

# Provider-neutral structured parser. Keep disabled for rule-only operation.
PARSER_AI_PROVIDER=disabled
PARSER_AI_BASE_URL=https://api.openai.com/v1
PARSER_AI_MODEL=
PARSER_AI_API_KEY=
PARSER_AI_TIMEOUT_MS=10000

# Tencent Cloud SMS. Leave SMS_DEV_MODE disabled outside local development.
SMS_DEV_MODE=0
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=ap-guangzhou
TENCENT_SMS_TEMPLATE_PARAMS=["{code}","{minutes}"]

# WeChat Open Platform website QR login.
WECHAT_OPEN_APP_ID=
WECHAT_OPEN_APP_SECRET=
WECHAT_REDIRECT_URI=
